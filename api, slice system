<helpers.js>
import { createAsyncThunk } from "@reduxjs/toolkit"
import _ from "lodash"
import moment from "moment"
import { cacheAdapter } from "../adapters"

export const createAsyncThunks = (sliceName, thunks) => {
	const thunkCreators = {}
	_.each(thunks, (creator, apiName) => {
		const type = `${sliceName}/${apiName}`
		const { payloadCreator, options = {}, dispatchAfterReject, cacheResult } = creator
		let dispatchAfterFulfil = creator.dispatchAfterFulfil
		thunkCreators[apiName] = createAsyncThunk(
			type,
			async (params, thunkApi) => {
				const { dispatch, getState, rejectWithValue } = thunkApi
				if (cacheResult) {
					const { interval, path = type } = cacheResult
					const cacheKey = `${path}/${JSON.stringify(params || '')}`
					const { data, setAt } = cacheAdapter.getSelectors().selectById(getState().cache, cacheKey) || {}
					if (setAt && moment().diff(moment.unix(setAt), 'minutes') < interval) {
            dispatchAfterFulfil?.(params, thunkApi, { data })
            return data
					} else {
						const incomingDispatchAfterFulfil = dispatchAfterFulfil
						dispatchAfterFulfil = (params, thunkApi, response) => {
							dispatch({
								type: 'cache/setCache',
								payload: {
									key: cacheKey,
									data: response.data,
									setAt: moment().unix()
								}
							})
              incomingDispatchAfterFulfil?.(params, thunkApi, response)
						}
					}
				}
				try {
					const response = await payloadCreator(params, thunkApi)
					dispatchAfterFulfil?.(params, thunkApi, response)
					return response.data
				} catch (error) {
					dispatchAfterReject?.(params, thunkApi, error)
					if (error.data) throw rejectWithValue(error.data)
					else {
						console.error(error)
						throw rejectWithValue(error.message)
					}
				}
			},
			options
		)
	})
	return thunkCreators
}


export const makeExtraReducers = (thunks, userThunkCreators) => (builder) => {
	const builderMethods = ["addCases", "addMatchers", "addDefaultCases"]
	_.each(thunks, (userApi, apiName) => {
		_.each(builderMethods, (method) => {
			const builderName = method.slice(0, -1)
			const builderCases = userApi[method]
			if (builderCases) {
				_.each(builderCases, (caseBuilder, lifeCycle) => {
					builder[builderName](
						userThunkCreators[apiName][lifeCycle],
						caseBuilder
					)
				})
			}
		})
	})
}
