import { createSlice } from "@reduxjs/toolkit"
import _ from "lodash"
import { customWorkAdapter, siteAdapter, snapshotAdapter, stagingAdapter, wpUserAdapter } from "../adapters"
import { siteExtraReducers, sitesSliceName } from "../apis/siteApi"

const initialState = {
	sites: siteAdapter.getInitialState(),
	snapshots: snapshotAdapter.getInitialState(),
	fileVersions: {},
	stagingSites: stagingAdapter.getInitialState(),
	wpUsers: wpUserAdapter.getInitialState(),
	customWorks: customWorkAdapter.getInitialState(),
}

const siteReducer = createSlice({
	name: sitesSliceName,
	initialState,
	reducers: {
		deleteCustomWork: (state, action) => {
			const { customWorkGid, siteGid } = action.payload
			customWorkAdapter.removeOne(state.customWorks, customWorkGid)
			state.sites.entities[siteGid].customWorks = state.customWorks.ids
		},
		upsertManyCustomWork: (state, action) => {
			const { customWorks, siteGid } = action.payload
			customWorkAdapter.upsertMany(state.customWorks, customWorks)
			state.sites.entities[siteGid].customWorks = state.customWorks.ids
		},
		upsertManySites: (state, action) => {
			siteAdapter.upsertMany(state.sites, action.payload)
		},
		upsertManySnapshots: (state, action) => {
			const { snapshots, siteGid } = action.payload
			snapshotAdapter.upsertMany(state.snapshots, snapshots)
			const backups = state.sites.entities[siteGid].backups || {}
			backups.snapshots = snapshots.map(snapshotAdapter.selectId)
			state.sites.entities[siteGid].backups = backups
		},
		upsertOneCustomWork: (state, action) => {
			const { customWork, siteGid } = action.payload
			customWorkAdapter.upsertOne(state.customWorks, customWork)
			state.sites.entities[siteGid].customWorks = state.customWorks.ids
		},
		upsertOneSnapshot: (state, action) => {
			const { snapshot, siteGid } = action.payload
			snapshotAdapter.upsertOne(state.snapshots, snapshot)
			const backups = state.sites.entities[siteGid].backups || {}
			backups.snapshots = backups.snapshots || []
			backups.snapshots.push(snapshotAdapter.selectId(snapshot))
			state.sites.entities[siteGid].backups = backups
		},
		upsertOneStaging: (state, action) => {
			const stagingSite = action.payload
			stagingAdapter.upsertOne(state.stagingSites, stagingSite)
			state.sites.entities[stagingSite.blog_gid].staging = stagingSite.gid
		},
		updateOneSite: (state, action) => {
			const { site, replace } = action.payload
			if (replace) {
				siteAdapter.setOne(state.sites, site)
			} else {
				siteAdapter.upsertOne(state.sites, action.payload)
			}
		},
		updateSitesLabels: (state, action) => {
			_.each(action.payload, (site, siteGid) => {
				state.sites.entities[siteGid].labels = site.labels
			})
		},
		updateSiteWith: (state, action) => {
			const { key, value, gid } = action.payload
			_.set(state.sites.entities[gid], key, value)
		},
	},
	extraReducers: siteExtraReducers,
})

export const {
	deleteCustomWork,
	upsertManySites,
	upsertManySnapshots,
	upsertManyCustomWork,
	upsertOneCustomWork,
	upsertOneSnapshot,
	upsertOneStaging,
	updateOneSite,
	updateSitesLabels,
	updateSiteWith,
} = siteReducer.actions

export default siteReducer.reducer
